{
  "name": "Pagos Farmacia",
  "short_name": "Pagos",
  "description": "Pagos a proveedores con su comprobante, gastos y sueldos (RoFac)",
  "start_url": "./#principal",
  "scope": "./",
  "display": "standalone",
  "background_color": "#12324a",
  "theme_color": "#12324a",
  "lang": "es-AR",
  "icons": [
    { "src": "img/icono-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "img/icono-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "img/icono-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [ { "name": "archivos", "accept": ["image/*", "application/pdf", ".pdf", ".jpg", ".jpeg", ".png"] } ]
    }
  }
}
